# ─── Credentials ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ─── Data: nothing from a provider is ever committed ──────────
# Licensing depends on this. Do not add exceptions.
*.db
*.duckdb
*.sqlite
*.sqlite3
data/
raw/
cache/
snapshots/
probe/out/
*.csv
*.parquet
*.feather

# JSON is allowed only for config, schemas and fixtures
*.json
!package.json
!package-lock.json
!tsconfig.json
!contracts/**/*.json
!config/**/*.json
# Replay fixtures. Synthetic payloads only - shapes, error envelopes and
# structural data hand-written to reproduce failure modes. No provider
# response is ever copied in here, so the no-provider-data rule holds.
!probe/fixtures/**/*.json

# ─── Documents: PDFs are not a source format ──────────────────
# Source documents arrive as pasted text. A PDF that reaches the tree gets
# machine-extracted into Markdown and then reads exactly like something that
# was written here, with no record that a lossy step happened. Ignored so it
# takes a --force to commit one, and hard-failed by
# audit/checks/no_pdf_provenance.py so the --force does not help.
*.pdf
*.PDF

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ─── Node ─────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.vite/

# ─── Editors / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
